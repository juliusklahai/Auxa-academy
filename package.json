{
  "name": "maestro",
  "private": true,
  "version": "0.1.0",
  "description": "Maestro: piano, theory, sight-reading and vocal training academy (Phase 1)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:hand": "esbuild tools/build-hand.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-hand.mjs && node node_modules/.cache/build-hand.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "opensheetmusicdisplay": "^2.2.1",
    "opentype.js": "^2.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "vexflow": "^4.2.5"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  }
}
